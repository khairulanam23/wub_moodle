{{!
    @template local_wub_policy/policy_page

    Policy Page Template styled exactly like elearning.org.bd/teacher/terms_conditions.php
}}

<div class="wub-policy-page" id="wub-policy-page">
    <div class="wub-policy-container">
        <form action="{{formaction}}" method="post" id="wub-policy-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="role" value="{{role}}">
            <input type="hidden" name="returnurl" value="{{returnurl}}">

            <div class="card wub-policy-card">
                <div class="card-header wub-policy-card-header">
                    {{ roletitle }} - {{ str_policyheader }}
                </div>
                <div class="card-body wub-policy-card-body">
                    {{#haserror}}
                    <div class="alert alert-danger wub-policy-alert" role="alert">
                        {{ errormessage }}
                    </div>
                    {{/haserror}}

                    <div class="wub-policy-body-text">
                        {{{ policyhtml }}}
                    </div>

                    <hr class="wub-policy-divider">

                    <div class="wub-policy-checkbox-row">
                        <label class="wub-policy-checkbox-label">
                            <input type="checkbox" id="terms_condition_agree" name="agree" value="1">
                            <b>{{ str_agreecheckbox }}</b>
                        </label>
                    </div>
                </div>
            </div>

            <div class="wub-policy-action-bar">
                <a href="{{cancelurl}}" class="btn btn-secondary wub-policy-cancel-btn">
                    {{ str_cancelbtn }}
                </a>
                <button type="submit" id="continue-button" class="btn btn-primary wub-policy-continue-btn" disabled="disabled">
                    {{ str_continuebtn }}
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var checkbox = document.getElementById('terms_condition_agree');
    var btn = document.getElementById('continue-button');
    if (checkbox && btn) {
        checkbox.addEventListener('change', function() {
            if (this.checked) {
                btn.removeAttribute('disabled');
                btn.classList.add('active-enabled');
            } else {
                btn.setAttribute('disabled', 'disabled');
                btn.classList.remove('active-enabled');
            }
        });
    }
});
</script>
