{{!
    @template local_wub_login/login_page

    Custom WUB Login Page Template matching WUB Landing theme.
}}

<div class="wub-login-page" id="wub-login-page">
    <div class="wub-login-container">
        <div class="wub-login-card">
            <div class="wub-login-row">
                {{! Left Column: WUB Building Photo }}
                <div class="wub-login-col-img">
                    <div class="wub-login-image">
                        <img src="{{heroimageurl}}" alt="World University of Bangladesh" class="wub-building-img">
                    </div>
                </div>

                {{! Right Column: Login Form }}
                <div class="wub-login-col-form">
                    <div class="wub-login-form-wrap">
                        <div class="wub-login-brand-header">
                            <h1 class="wub-login-title">{{ str_loginheader }}</h1>
                            <p class="wub-login-subtitle">{{ str_loginsubtitle }}</p>
                        </div>

                        {{#hasrole}}
                        <div class="wub-role-indicator {{roleclass}}">
                            <span class="wub-role-indicator-text">{{ rolebadge }}</span>
                        </div>
                        {{/hasrole}}

                        {{#haserror}}
                        <div class="wub-login-alert wub-alert-danger" role="alert">
                            <span>{{ errormessage }}</span>
                        </div>
                        {{/haserror}}

                        <form action="{{loginaction}}" method="post" id="wub-login-form" class="wub-login-form">
                            <input type="hidden" name="logintoken" value="{{logintoken}}">

                            <div class="wub-form-group">
                                <label for="wub-username" class="wub-form-label">{{ str_username }}</label>
                                <div class="wub-input-wrap">
                                    <span class="wub-input-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    </span>
                                    <input type="text"
                                           name="username"
                                           id="wub-username"
                                           class="wub-form-control"
                                           placeholder="{{ str_username_placeholder }}"
                                           value="{{username}}"
                                           required
                                           autofocus
                                           autocomplete="username">
                                </div>
                            </div>

                            <div class="wub-form-group">
                                <label for="wub-password" class="wub-form-label">{{ str_password }}</label>
                                <div class="wub-input-wrap">
                                    <span class="wub-input-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    </span>
                                    <input type="password"
                                           name="password"
                                           id="wub-password"
                                           class="wub-form-control"
                                           placeholder="{{ str_password_placeholder }}"
                                           required
                                           autocomplete="current-password">
                                </div>
                            </div>

                            <div class="wub-form-options">
                                <label class="wub-checkbox-wrap">
                                    <input type="checkbox" name="rememberusername" value="1" id="wub-rememberusername">
                                    <span class="wub-checkbox-label">{{ str_rememberusername }}</span>
                                </label>
                                <a href="{{forgotpasswordurl}}" class="wub-forgot-link">{{ str_forgotpassword }}</a>
                            </div>

                            <button type="submit" class="wub-login-submit-btn" id="wub-login-submit">
                                <span>{{ str_loginbtn }}</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                            </button>
                        </form>

                        <div class="wub-login-back-wrap">
                            <a href="{{landingurl}}" class="wub-login-back-link" id="wub-back-landing">
                                {{ str_backtolanding }}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
