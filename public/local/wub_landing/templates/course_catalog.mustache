{{!
    @template local_wub_landing/course_catalog

    Course catalog page template.

    Context variables required for this template:
    * pageheading - Page heading text
    * searchvalue - Current search query
    * searchaction - Form action URL
    * categories - Array of category filter options
    * hascourses - Whether courses were found
    * courses - Array of course data objects
    * nocoursesfound - No results message
    * pagination - Pagination data object
    * landingurl - URL back to landing page
    * hasactivefilters - Whether filters are active
    * clearfiltersurl - URL to clear filters
    * str_* - Translated string labels

    Example context (json):
    {
        "pageheading": "All Courses",
        "searchvalue": "",
        "searchaction": "/local/wub_landing/catalog.php",
        "hascourses": true,
        "courses": [],
        "str_searchcourses": "Search courses...",
        "str_allcategories": "All Categories",
        "str_search": "Search",
        "str_coursecatalog": "Course Catalog",
        "landingurl": "/local/wub_landing/"
    }
}}

<div class="wub-catalog-page" id="wub-catalog-page">
    <div class="wub-catalog-header">
        <div class="wub-catalog-header-inner">
            <h1 class="wub-catalog-title" id="wub-catalog-title">{{ str_coursecatalog }}</h1>
            <p class="wub-catalog-subtitle">{{ pageheading }}</p>
        </div>
    </div>

    <div class="wub-catalog-content">
        {{! Search and filter bar }}
        <div class="wub-catalog-filters" id="wub-catalog-filters">
            <form method="get" action="{{searchaction}}" class="wub-catalog-search-form">
                <div class="wub-search-row">
                    <div class="wub-search-input-wrap">
                        <input type="text"
                               name="search"
                               id="wub-catalog-search"
                               class="wub-search-input"
                               placeholder="{{ str_searchcourses }}"
                               value="{{searchvalue}}"
                               aria-label="{{ str_searchcourses }}">
                    </div>
                    <div class="wub-category-select-wrap">
                        <label for="wub-catalog-category" class="sr-only">{{ str_category }}</label>
                        <select name="categoryid" id="wub-catalog-category" class="wub-category-select">
                            <option value="0">{{ str_allcategories }}</option>
                            {{#categories}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                            {{/categories}}
                        </select>
                    </div>
                    <button type="submit" class="wub-search-btn" id="wub-search-submit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        <span>{{ str_search }}</span>
                    </button>
                </div>

                {{#hasactivefilters}}
                <div class="wub-active-filters">
                    <a href="{{clearfiltersurl}}" class="wub-clear-filters" id="wub-clear-filters">{{ str_clearfilters }}</a>
                </div>
                {{/hasactivefilters}}
            </form>
        </div>

        {{! Course grid }}
        {{#hascourses}}
        <div class="wub-course-grid" id="wub-course-grid">
            {{#courses}}
                {{> local_wub_landing/course_card }}
            {{/courses}}
        </div>
        {{/hascourses}}

        {{^hascourses}}
        <div class="wub-no-results" id="wub-no-results">
            <div class="wub-no-results-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M8 11h6"/></svg>
            </div>
            <p class="wub-no-results-text">{{ nocoursesfound }}</p>
            <a href="{{clearfiltersurl}}" class="wub-no-results-link">{{ str_clearfilters }}</a>
        </div>
        {{/hascourses}}

        {{! Pagination }}
        {{#pagination.haspagination}}
        <nav class="wub-pagination" aria-label="Course catalog pagination" id="wub-pagination">
            {{#pagination.hasprev}}
            <a href="{{pagination.prevurl}}" class="wub-page-link wub-page-prev" aria-label="Previous page">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </a>
            {{/pagination.hasprev}}

            {{#pagination.pages}}
            <a href="{{url}}" class="wub-page-link {{#active}}wub-page-active{{/active}}" {{#active}}aria-current="page"{{/active}}>
                {{pagenum}}
            </a>
            {{/pagination.pages}}

            {{#pagination.hasnext}}
            <a href="{{pagination.nexturl}}" class="wub-page-link wub-page-next" aria-label="Next page">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
            {{/pagination.hasnext}}
        </nav>
        {{/pagination.haspagination}}
    </div>

    <div class="wub-catalog-back">
        <a href="{{landingurl}}" class="wub-back-link" id="wub-back-to-landing">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            Back to WUB Landing
        </a>
    </div>
</div>
