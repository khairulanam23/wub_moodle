{{!
    @template local_wub_landing/landing_page_auth

    Landing page for authenticated users matching WUB card theme.
}}

<div class="wub-landing-page landing-page-bg" id="wub-landing-page-auth">
    <div class="frontpage-guest-content centered">
        <div class="wub-landing-container">
            <div class="guest-home-welcome-card">
                <div class="wub-card-row">
                    {{! Left Column: WUB Building Photo }}
                    <div class="wub-card-col-img">
                        <div class="guest-home-welcome-image landing-page-box-img">
                            <img src="{{heroimageurl}}" alt="World University of Bangladesh" class="wub-building-img">
                        </div>
                    </div>

                    {{! Right Column: Authenticated Welcome & Action Buttons }}
                    <div class="wub-card-col-form">
                        <div class="guest-home-welcome-form">
                            <p id="frontpage-guest-welcome-card-title" class="text-align-center">
                                {{{ title }}}
                            </p>

                            <p class="text-align-center guest-home-welcome-card-info-text">
                                <b>{{ loggedinas }}</b>
                            </p>

                            <p class="text-align-center guest-home-welcome-card-info-text">
                                {{ browsecoursesbelow }}
                            </p>

                            <div class="welcome-card-buttons wub-auth-buttons">
                                <a href="{{dashboardurl}}" class="wub-auth-btn wub-auth-btn-dashboard" id="wub-btn-dashboard">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                                    <p>{{ str_gotodashboard }}</p>
                                </a>

                                {{#catalogenabled}}
                                <a href="{{catalogurl}}" class="wub-auth-btn wub-auth-btn-catalog" id="wub-btn-catalog-auth">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                    <p>{{ str_coursecatalog }}</p>
                                </a>
                                {{/catalogenabled}}

                                <a href="{{logouturl}}" class="wub-auth-btn wub-auth-btn-logout" id="wub-btn-logout">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                                    <p>{{ str_logout }}</p>
                                </a>
                            </div>

                            {{#hasfooterlinks}}
                            <div class="guest-welcome-footer-links">
                                {{#hascontactus}}
                                <a href="{{contactusurl}}" id="wub-link-contact">{{ str_contactus }}</a>
                                {{/hascontactus}}
                                {{#hascontactus}}{{#hashowtoguides}}
                                <span class="wub-footer-sep">|</span>
                                {{/hashowtoguides}}{{/hascontactus}}
                                {{#hashowtoguides}}
                                <a href="{{howtoguidesurl}}" id="wub-link-howto">{{ str_howtoguides }}</a>
                                {{/hashowtoguides}}
                            </div>
                            {{/hasfooterlinks}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

