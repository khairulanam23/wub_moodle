{{!
    @template local_wub_landing/landing_page_auth

    Landing page for authenticated users.

    Context variables required for this template:
    * title - Landing page title
    * userfullname - Full name of logged-in user
    * loggedinas - "You are logged in as X" string
    * browsecoursesbelow - Browse courses instruction text
    * dashboardurl - URL to user dashboard
    * logouturl - URL to logout
    * catalogenabled - Whether catalog is shown
    * catalogurl - URL for course catalog
    * hasfooterlinks - Whether footer links exist
    * str_* - Translated string labels

    Example context (json):
    {
        "title": "Welcome to WUB",
        "userfullname": "John Doe",
        "loggedinas": "You are logged in as John Doe",
        "browsecoursesbelow": "Browse courses or go to your dashboard.",
        "dashboardurl": "/my/",
        "logouturl": "/login/logout.php?sesskey=abc123",
        "catalogenabled": true,
        "catalogurl": "/local/wub_landing/catalog.php",
        "hasfooterlinks": false,
        "str_gotodashboard": "Go to Dashboard",
        "str_coursecatalog": "Course Catalog",
        "str_logout": "Logout",
        "str_contactus": "Contact Us",
        "str_howtoguides": "How-to Guides"
    }
}}

<div class="wub-landing-page" id="wub-landing-page-auth">
    <div class="wub-landing-container">
        <div class="wub-welcome-card wub-welcome-card-auth">
            <div class="wub-welcome-card-inner wub-welcome-card-inner-auth">
                {{! Left side: decorative visual }}
                <div class="wub-welcome-visual">
                    <div class="wub-welcome-visual-content">
                        <div class="wub-visual-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="80" height="80" fill="none" aria-hidden="true">
                                <circle cx="32" cy="32" r="30" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
                                <path d="M20 44V24l12-8 12 8v20" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                <rect x="26" y="34" width="12" height="10" rx="1" stroke="white" stroke-width="2" stroke-linecap="round"/>
                                <path d="M32 16v-2M24 18l-2-2M40 18l2-2" stroke="rgba(255,255,255,0.6)" stroke-width="2" stroke-linecap="round"/>
                                <circle cx="32" cy="28" r="3" stroke="white" stroke-width="2"/>
                            </svg>
                        </div>
                        <div class="wub-visual-text">
                            <span class="wub-visual-brand">WUB</span>
                            <span class="wub-visual-tagline">eLearning Platform</span>
                        </div>
                    </div>
                </div>

                {{! Right side: authenticated options }}
                <div class="wub-welcome-actions">
                    <h1 class="wub-welcome-title">
                        {{{ title }}}
                    </h1>

                    <div class="wub-auth-greeting">
                        <p class="wub-auth-loggedinas">{{ loggedinas }}</p>
                        <p class="wub-auth-instruction">{{ browsecoursesbelow }}</p>
                    </div>

                    <div class="wub-auth-buttons">
                        <a href="{{dashboardurl}}" class="wub-role-btn wub-role-btn-dashboard" id="wub-btn-dashboard">
                            <span class="wub-role-btn-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            </span>
                            <span class="wub-role-btn-label">{{ str_gotodashboard }}</span>
                        </a>

                        {{#catalogenabled}}
                        <a href="{{catalogurl}}" class="wub-role-btn wub-role-btn-catalog-auth" id="wub-btn-catalog-auth">
                            <span class="wub-role-btn-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                            </span>
                            <span class="wub-role-btn-label">{{ str_coursecatalog }}</span>
                        </a>
                        {{/catalogenabled}}

                        <a href="{{logouturl}}" class="wub-role-btn wub-role-btn-logout" id="wub-btn-logout">
                            <span class="wub-role-btn-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                            </span>
                            <span class="wub-role-btn-label">{{ str_logout }}</span>
                        </a>
                    </div>

                    {{#hasfooterlinks}}
                    <div class="wub-footer-links">
                        {{#hascontactus}}
                        <a href="{{contactusurl}}" class="wub-footer-link">{{ str_contactus }}</a>
                        {{/hascontactus}}
                        {{#hascontactus}}{{#hashowtoguides}}
                        <span class="wub-footer-separator" aria-hidden="true">|</span>
                        {{/hashowtoguides}}{{/hascontactus}}
                        {{#hashowtoguides}}
                        <a href="{{howtoguidesurl}}" class="wub-footer-link">{{ str_howtoguides }}</a>
                        {{/hashowtoguides}}
                    </div>
                    {{/hasfooterlinks}}
                </div>
            </div>
        </div>
    </div>
</div>
