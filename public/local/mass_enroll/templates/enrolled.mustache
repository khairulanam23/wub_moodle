{{!
    @template local_mass_enroll/enrolled
}}
<style>
    .ladda-button[data-size="xs"] {
        padding: 0px 8px !important;
    }
    .course_div span {
        background: #fff;
        color: #000;
        padding: 2px;
        border-radius: 1px;
        font-weight: 400;
        margin: 1px 0px;
        display: inline-block;
    }
</style>
<div class="wub-mass-enroll-container">
    <div class="wub-banner-header">
        <div>
            <h2><i class="fa fa-graduation-cap me-2"></i>WUB Bulk Enrollment Portal</h2>
            <p>Select course categories, programs, batches, and seamlessly enroll students with full verification.</p>
        </div>
        <div>
            <a href="/local/mass_enroll/sync.php" class="wub-banner-btn-solid"><i class="fa fa-refresh me-1"></i> UMS Sync</a>
        </div>
    </div>

    <form action="/local/mass_enroll/request_enrolled.php" method="POST" id="bulk_enrolled">
        <input type="hidden" name="sesskey" value="{{sesskey}}" />
        <div class="row">
            <!-- Left Panel: Course Selection -->
            <div class="col-lg-6 mb-4">
                <div class="wub-section-card">
                    <div class="wub-card-title">
                        <span><i class="fa fa-book me-2"></i> 1. Select Courses</span>
                    </div>

                    <div class="wub-form-group">
                        <label for="courses_category">Course Category (Local DB)</label>
                        <select class="courses_category select2" id="courses_category" data-placeholder="Choose Course Category">
                            <option value=""></option>
                            {{#courses_category}}
                            <option value="{{id}}">{{name}}</option>
                            {{/courses_category}}
                        </select>
                    </div>

                    <div class="row wub-form-group">
                        <div class="col-6">
                            <label for="en_start">Enrolment Starts</label>
                            <input type="date" name="en_start" class="form-control wub-form-control" id="en_start" />
                        </div>
                        <div class="col-6">
                            <label for="en_end">Enrolment Ends</label>
                            <input type="date" name="en_end" class="form-control wub-form-control" id="en_end" />
                        </div>
                    </div>

                    <div class="text-center mb-3">
                        <button class="btn btn-wub-primary ladda-button" data-size="xs" type="button" id="search_courses" data-style="zoom-in"><label class="ladda-label"><i class="fa fa-search me-1"></i> Search Courses</label></button>
                    </div>

                    <div id="courses_list">
                        <div class="wub-search-box-wrapper">
                            <i class="fa fa-search search-icon"></i>
                            <input type="text" class="search" placeholder="Type to filter courses..." />
                            <div class="wub-check-all-toggle">
                                <input type="checkbox" id="check_all_courses" checked />
                                <label for="check_all_courses">All</label>
                            </div>
                        </div>
                        <input type="hidden" name="courses" id="courses" />
                        <ul class="list" id="list_courses"></ul>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Student Selection -->
            <div class="col-lg-6 mb-4">
                <div class="wub-section-card">
                    <div class="wub-card-title">
                        <span><i class="fa fa-users me-2"></i> 2. Select Students</span>
                    </div>

                    <div class="wub-form-group">
                        <label for="program_id">Program</label>
                        <select class="program_id select2" id="program_id" data-placeholder="Choose Program">
                            <option value=""></option>
                            {{#programs}}
                            <option value="{{id}}">{{title}}</option>
                            {{/programs}}
                        </select>
                    </div>

                    <div class="wub-form-group">
                        <label for="batch_id">Batch</label>
                        <select class="batch_id select2" id="batch_id" data-placeholder="Choose Batch">
                            <option value=""></option>
                        </select>
                    </div>

                    <div class="wub-form-group">
                        <label for="emails">Email Filter (Optional)</label>
                        <textarea id="emails" class="form-control wub-form-control" name="emails" rows="2" placeholder="Enter comma-separated emails e.g. student1@wub.edu.bd, student2@wub.edu.bd"></textarea>
                    </div>

                    <div class="text-center mb-3">
                        <button class="btn btn-wub-primary ladda-button" data-size="xs" type="button" id="search_students" data-style="zoom-in"><label class="ladda-label"><i class="fa fa-search me-1"></i> Search Students</label></button>
                    </div>

                    <div id="users_list">
                        <div class="wub-search-box-wrapper">
                            <i class="fa fa-search search-icon"></i>
                            <input type="text" class="search" placeholder="Type to filter students..." />
                            <div class="wub-check-all-toggle">
                                <input type="checkbox" id="check_all_students" checked />
                                <label for="check_all_students">All</label>
                            </div>
                        </div>
                        <input type="hidden" name="users" id="users" />
                        <ul class="list" id="list_users"></ul>
                    </div>
                </div>
            </div>

            <div class="col-md-12" id="selected_users" hidden>
                <h3>Selected users</h3>
                <p id="selected-users-list-empty">No users selected</p>
                <ul class="selected-users-list"></ul>
            </div>
        </div>

        <div class="row" style="margin-top: 16px;">
            <div class="col-md-12" id="output_users" style="display: none;padding: 0;">
                <h3>Submitted Result</h3>
                <p id="selected-users-list-empty">No users selected</p>
                <ul class="selected-users-list"></ul>
            </div>
        </div>

        <div class="wub-actions-bar">
            <button class="btn btn-wub-success ladda-button Large me-2" id="bulk_enrol_btn" type="submit" data-style="expand-right"><span class="ladda-label"><i class="fa fa-check-circle me-1"></i> Verify & Proceed to Enrol</span></button>
            <button class="btn btn-wub-success ladda-button Large me-2" id="bulk_enrol_btn_submit" type="submit" data-style="expand-right" style="display: none"><span class="ladda-label"><i class="fa fa-paper-plane me-1"></i> Submit Enrolments</span></button>
            <a href="/local/mass_enroll/enrolled.php" class="btn btn-wub-secondary"><i class="fa fa-refresh me-1"></i> Reset</a>
        </div>
    </form>
</div>

<textarea id="api_std" hidden>{{api_std}}</textarea>
