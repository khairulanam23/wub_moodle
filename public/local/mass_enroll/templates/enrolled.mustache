<style>
    .ladda-button[data-size="xs"] {
        padding: 0px 8px !important;
    }
    .course_div {}
    .course_div  span{
        background: #fff;
        color: #000;
        padding: 2px;
        border-radius: 1px;
        font-weight: 400;
        margin: 1px 0px;
        display: inline-block;
    }
</style>
<div class="wub-mass-enroll-container">
    <div class="wub-banner-header">
        <div>
            <h2><i class="fa fa-graduation-cap me-2"></i>WUB Bulk Enrollment Portal</h2>
            <p>Select course categories, programs, batches, and seamlessly enroll students with full verification.</p>
        </div>
        <div>
            <a href="/local/mass_enroll/sync.php" class="wub-banner-btn-solid"><i class="fa fa-refresh me-1"></i> UMS Sync</a>
        </div>
    </div>

    <form action="/local/mass_enroll/request_enrolled.php" method="POST" id="bulk_enrolled">
        <div class="row">
            <!-- Left Panel: Course Selection -->
            <div class="col-lg-6 mb-4">
                <div class="wub-section-card">
                    <div class="wub-card-title">
                        <span><i class="fa fa-book me-2"></i> 1. Select Courses</span>
                    </div>

                    <div class="wub-form-group">
                        <label for="courses_category">Course Category (Local DB)</label>
                        <select class="courses_category select2" id="courses_category" data-placeholder="Choose Course Category">
                            <option value=""></option>
                            {{#courses_category}}
                            <option value="{{id}}">{{name}}</option>
                            {{/courses_category}}
                        </select>
                    </div>

                    <div class="row wub-form-group">
                        <div class="col-6">
                            <label for="en_start">Enrolment Starts</label>
                            <input type="date" name="en_start" class="form-control wub-form-control" id="en_start" />
                        </div>
                        <div class="col-6">
                            <label for="en_end">Enrolment Ends</label>
                            <input type="date" name="en_end" class="form-control wub-form-control" id="en_end" />
                        </div>
                    </div>

                    <div class="text-center mb-3">
                        <button class="btn btn-wub-primary ladda-button" data-size="xs" type="button" id="search_courses" data-style="zoom-in"><label class="ladda-label"><i class="fa fa-search me-1"></i> Search Courses</label></button>
                    </div>

                    <div id="courses_list">
                        <div class="wub-search-box-wrapper">
                            <i class="fa fa-search search-icon"></i>
                            <input type="text" class="search" placeholder="Type to filter courses..." />
                            <div class="wub-check-all-toggle">
                                <input type="checkbox" id="check_all_courses" checked onchange="javascript:selection_check(this);" />
                                <label for="check_all_courses">All</label>
                            </div>
                        </div>
                        <input type="hidden" name="courses" id="courses" />
                        <ul class="list" id="list_courses"></ul>
                    </div>
                </div>
            </div>

            <!-- Right Panel: Student Selection -->
            <div class="col-lg-6 mb-4">
                <div class="wub-section-card">
                    <div class="wub-card-title">
                        <span><i class="fa fa-users me-2"></i> 2. Select Students</span>
                    </div>

                    <div class="wub-form-group">
                        <label for="program_id">Program</label>
                        <select class="program_id select2" id="program_id" data-placeholder="Choose Program">
                            <option value=""></option>
                            {{#programs}}
                            <option value="{{id}}">{{title}}</option>
                            {{/programs}}
                        </select>
                    </div>

                    <div class="wub-form-group">
                        <label for="batch_id">Batch</label>
                        <select class="batch_id select2" id="batch_id" data-placeholder="Choose Batch">
                            <option value=""></option>
                        </select>
                    </div>

                    <div class="wub-form-group">
                        <label for="emails">Email Filter (Optional)</label>
                        <textarea id="emails" class="form-control wub-form-control" name="emails" rows="2" placeholder="Enter comma-separated emails e.g. student1@wub.edu.bd, student2@wub.edu.bd"></textarea>
                    </div>

                    <div class="text-center mb-3">
                        <button class="btn btn-wub-primary ladda-button" data-size="xs" type="button" id="search_students" data-style="zoom-in"><label class="ladda-label"><i class="fa fa-search me-1"></i> Search Students</label></button>
                    </div>

                    <div id="users_list">
                        <div class="wub-search-box-wrapper">
                            <i class="fa fa-search search-icon"></i>
                            <input type="text" class="search" placeholder="Type to filter students..." />
                            <div class="wub-check-all-toggle">
                                <input type="checkbox" id="check_all_students" checked onchange="javascript:selection_check_2(this);" />
                                <label for="check_all_students">All</label>
                            </div>
                        </div>
                        <input type="hidden" name="users" id="users" />
                        <ul class="list" id="list_users"></ul>
                    </div>
                </div>
            </div>

            <div class="col-md-12" id="selected_users" hidden>
                <h3>Selected users</h3>
                <p id="selected-users-list-empty">No users selected</p>
                <ul class="selected-users-list"></ul>
            </div>
        </div>

        <div class="row" style="margin-top: 16px;">
            <div class="col-md-12" id="output_users" style="display: none;padding: 0;">
                <h3>Submitted Result</h3>
                <p id="selected-users-list-empty">No users selected</p>
                <ul class="selected-users-list"></ul>
            </div>
        </div>

        <div class="wub-actions-bar">
            <button class="btn btn-wub-success ladda-button Large me-2" id="bulk_enrol_btn" type="submit" data-style="expand-right"><span class="ladda-label"><i class="fa fa-check-circle me-1"></i> Verify & Proceed to Enrol</span></button>
            <button class="btn btn-wub-success ladda-button Large me-2" id="bulk_enrol_btn_submit" type="submit" data-style="expand-right" style="display: none"><span class="ladda-label"><i class="fa fa-paper-plane me-1"></i> Submit Enrolments</span></button>
            <a href="/local/mass_enroll/enrolled.php" class="btn btn-wub-secondary"><i class="fa fa-refresh me-1"></i> Reset</a>
        </div>
    </form>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<!--<script src="https://cdnjs.cloudflare.com/ajax/libs/list.js/1.5.0/list.min.js"></script>-->
<!--<script src="/local/mass_enroll/js/spin.min.js"></script>-->
<!--<script src="/local/mass_enroll/js/ladda.min.js"></script>-->
<!--<script src="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/10.16.3/sweetalert2.min.js"></script>-->

<textarea id="api_std" hidden>{{api_std}}</textarea>
<script type="text/javascript">
    let btn_txt = "bulk_enrol_btn";
    let uri = "/local/mass_enroll/request_enrolled.php";
    let exists_std = [];

    let options = {
        valueNames: [
            'full_name',
            'student_email',
            'dept',
            {data: ['id','email','name'] },
        ],
        item: '<li class="user-item student-${id} col-xs-12 selected" onclick="toggleUser(this)">' +
                    '<div style="width: 100%;overflow: hidden;">' +
                        '<div style="padding: 0 0 0 10px;width: 100%;float: left;overflow: hidden;">' +
                            '<p class="full_name name col-xs-12"></p>' +
                            '<p class="student_email email col-xs-12" style="text-align: left;font-style: italic;font-size: 12px;"></p>' +
                            '<p class="dept col-xs-12" style="font-weight: 400;"></p>' +
                        '</div>' +
                    '</div>' +
                '</li>',

    };
    let options_course_list = {
        valueNames: [
            'fullname',
            'shortname',
            { data: ['id'] },
        ],
        item: '<li class="course-item selected" onclick="toggleCourse(this)"><span class="fullname"></span> - (<span class="shortname"></span>)</li>'
    };
    let userList;
    let courseList;
    var selected_courses = [];
    let selected_users = [];

    $(function () {
        userList = new List('users_list', options);
        courseList = new List('courses_list', options_course_list);
        $('.select2').select2({
            theme: "classic",
            width: '100%',
        });

        $('#program_id').on('select2:select', function (e) {
            let obj = e.params.data;
            $.ajax({
                url: '/local/mass_enroll/api.php',
                method: 'POST',
                data: {
                    program_id: obj.id,
                },
                success: function (res) {
                    let bs = $('#batch_id');
                    bs.empty();
                    bs.append(new Option('', '', true, true));
                    if (res){
                        let batches = (typeof res === 'string') ? JSON.parse(res) : res;
                        if (Array.isArray(batches)) {
                            for (let batch of batches){
                                let title = (typeof batch === 'object') ? (batch.batch_title || batch.id || batch) : batch;
                                let val = (typeof batch === 'object') ? (batch.batch_title || batch.id || batch) : batch;
                                const option = new Option(title, val, false, false);
                                bs.append(option);
                            }
                        }
                    }
                    bs.val('');
                    bs.trigger('change');
                },
                error: function (err) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: "System Error!! Error Code: " + err.status,
                    });
                }
            });
        });

        $("#bulk_enrolled").submit(function (e) {
            e.preventDefault();
            this.blur();

            let l = Ladda.create(document.querySelector("#"+btn_txt));
            l.start();

            let form = new FormData(this);

            let course = $("#courses").val();
            let users = $("#users").val();

            if (course && users){
                $.ajax({
                    url: uri,
                    cache: false,
                    contentType: false,
                    processData: false,
                    data: form,
                    type: "POST",
                    success: (res)=>{
                        $("#output_users").html(res);
                        $("#output_users").show();
                        $("#selected_users").hide();
                        setTimeout(()=>{
                            l.stop();
                            uri = "/local/mass_enroll/submit_enrolled.php";
                            $("#"+btn_txt).hide();
                            btn_txt = "bulk_enrol_btn_submit";
                            $("#"+btn_txt).show();
                        },500);
                    },
                    error: (err)=>{
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: "System Error ! error code: " + err.status,
                        });
                        setTimeout(()=>{
                            l.stop();
                        },1500);
                    }
                });
            }else{
                Swal.fire({
                    icon: 'warning',
                    title: 'Oops...',
                    text: 'Please select any courses & students!',
                });
                setTimeout(()=>{
                    l.stop();
                },1500);
            }
        });

        $("#search_courses").click(function(){
            let l = Ladda.create(this);
            l.start();
            let category = $("#courses_category").val().trim();
            let en_start = $("#en_start").val().trim();
            let en_end = $("#en_end").val().trim();
            if (category && en_start && en_end){
                $.ajax({
                    url: "/local/mass_enroll/api.php",
                    data: {'category_id':category},
                    method: 'POST',
                    success: (res)=>{
                        courseList.clear();
                        selected_courses = [];
                        if (res){
                            let courses = (typeof res === 'string') ? JSON.parse(res) : res;
                            if (courses.error) {
                                throw new Error(courses.error);
                            }
                            let courses_fm_list = [];
                            let input_val = [];
                            for (let i in courses){
                                let course = courses[i];
                                courses_fm_list.push({
                                    fullname: course.fullname,
                                    shortname: course.shortname,
                                    id: course.id,
                                });
                                input_val.push(course.id);
                                selected_courses.push(course.id);
                            }
                            $("#courses").val(input_val.join(','));
                            courseList.add(courses_fm_list);
                            $("#courses_category").find(':selected').attr('disabled','disabled');
                            $("#courses_category").val("").trigger('change');
                        }
                        l.stop();
                    },
                    error: (err)=>{
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: "System Error!! Error Code: ". err.status,
                        });
                        setTimeout(()=>{
                            l.stop();
                        },1000);
                    }
                });
            }else{
                Swal.fire({
                    icon: 'warning',
                    title: 'empty...',
                    text: "Please Select Any Course Category & Dates",
                });
                setTimeout(()=>{
                    l.stop();
                },1000);
            }
        });

        $("#search_students").click(function(){
            let l = Ladda.create(this);
            l.start();
            let program_id = $("#program_id").val().trim();
            let batch_id = $("#batch_id").val().trim();
            let emails = $("#emails").val().trim();
            if (program_id){
                $.ajax({
                    url: "/local/mass_enroll/api.php",
                    data: {
                        program: program_id,
                        batch: batch_id,
                        emails: emails
                    },
                    method: 'POST',
                    success: (res)=>{
                        userList.clear();
                        exists_std = [];
                        selected_users = [];
                        if (res){
                            let students = (typeof res === 'string') ? JSON.parse(res) : res;
                            let students_fm_list = [];
                            for (let i in students){
                                let student = students[i];
                                let s_id = student.id || student.username || ('std_' + i);
                                let fname = student.firstname || student.name || student.full_name || student.username || 'Student';
                                let lname = student.lastname || '';
                                let s_email = student.email || student.student_email || (student.username ? student.username + '@student.wub.edu.bd' : '');
                                let prog = student.program_id || student.program_name || program_id;
                                let bt = student.batch_id || student.mother_batch || batch_id;

                                if (!exists_std.includes(s_id)){
                                    students_fm_list.push({
                                        full_name: (fname + ' ' + lname).trim(),
                                        student_email: s_email,
                                        name: (fname + ' ' + lname).trim(),
                                        email: s_email,
                                        dept: prog + ' (' + bt + ')',
                                        id: s_id,
                                    });
                                    exists_std.push(s_id);
                                }
                                selected_users.push(s_id);
                            }
                            $("#users").val(selected_users.join(','));
                            userList.add(students_fm_list);
                        }
                        l.stop();
                    },
                    error: (err)=>{
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: "System Error!! Error Code: " + err.status,
                        });
                        setTimeout(()=>{
                            l.stop();
                        },1000);
                    }
                });
            }else{
                Swal.fire({
                    icon: 'warning',
                    title: 'empty...',
                    text: "Please Select Any Program & Batch",
                });
                setTimeout(()=>{
                    l.stop();
                },1000);
            }
        });
    });


    $(function () {
        $('#users_list .search').keydown(function(e){
            if(e.keyCode == 13){
                e.preventDefault()
            }
        });
    });


    function toggleUser(el)
    {
        var id =  el.getAttribute('data-id')
        var email =  el.getAttribute('data-email')
        var name = el.getAttribute('data-name')

        el.classList.toggle('selected')

        if(selected_users.includes(id))
        {
            let index = selected_users.indexOf(id)
            selected_users.splice(index, 1)

            $('.selected-user-item-' + id).remove()

            updateSelectedUsersListEmptyMessage()
        }
        else
        {
            selected_users.push(id)

            $('.selected-users-list').append(`
				<li class="selected-user-item selected-user-item-`+ id +`">`
                    + name + ` - `  + email +
                    `<img class="selected-user-item-close" src="/course/icons/close.png">
				</li>
			`)

            $('.selected-user-item-'+ id).click(function(e)
            {
                $('.selected-user-item-' + id).remove()

                let index = selected_users.indexOf(id)
                selected_users.splice(index, 1)

                el.classList.remove('selected')

                updateSelectedUsersListEmptyMessage()
            })
        }

        let hidden_input = $('input[name="users"]');

        hidden_input.val(selected_users.join(','))

        updateSelectedUsersListEmptyMessage()
    }

    function updateSelectedUsersListEmptyMessage()
    {
        if(selected_users.length == 0)
        {
            $('#selected-users-list-empty').text('No users selected')
        }
        else
        {
            $("#selected-users-list-empty").text('');
        }
    }


    function toggleCourse(el)
    {
        var id =  el.getAttribute('data-id')

        el.classList.toggle('selected')

        if(selected_courses.includes(id))
        {
            let index = selected_courses.indexOf(id)
            selected_courses.splice(index, 1)
        }
        else
        {
            selected_courses.push(id)
        }

        let hidden_input = $('input[name="courses"]');

        hidden_input.val(selected_courses.join(','))
    }

    function selection_check(index){
        let status = $(index).is(':checked');

        $('#list_courses li').each(function(e){
            if (status){
                $(this).addClass('selected');
                selected_courses.push($(this).data('id').toString());
            }else{
                $(this).removeClass('selected');
            }
        });
        if (status){
            $("#courses").val(selected_courses.join(','));
        }else{
            $("#courses").val("");
            selected_courses = [];
        }
    }

    function selection_check_2(index){
        let status = $(index).is(':checked');
        $('#list_users li').each(function(e){
            if (status){
                $(this).addClass('selected');
                selected_users.push($(this).data('id').toString());
            }else{
                $(this).removeClass('selected');
            }
        });
        if (status){
            $("#users").val(selected_users.join(','));
        }else{
            $("#users").val("");
            selected_users = [];
        }
    }

    function getCourses(courses){
        let span = '';
        console.log(courses);
        for (let course of courses){
            span += '<span data-toggle="tooltip" data-placement="top" title=" ' + course.title + ' ( ' + course.credit + ' ) ">'+ course.courseCode +'</span> ';
        }

        return span;
    }

</script>
