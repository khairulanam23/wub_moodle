{{!
    @template local_mass_enroll/sync
}}

<div class="wub-mass-enroll-container">
    <div class="wub-banner-header">
        <div>
            <h2><i class="fa fa-refresh me-2"></i>WUB User Data Synchronization</h2>
            <p>Fetch and synchronize UMS API student information directly into your Moodle database.</p>
        </div>
        <div>
            <a href="/local/mass_enroll/enrolled.php" class="wub-banner-btn-outline me-2"><i class="fa fa-graduation-cap me-1"></i> Bulk Enrolment</a>
            <a href="/local/mass_enroll/records.php" class="wub-banner-btn-solid"><i class="fa fa-list me-1"></i> View Records</a>
        </div>
    </div>

    <form action="/local/mass_enroll/api.php" method="POST" id="bulk_sync">
        <div class="wub-section-card mb-4">
            <div class="wub-card-title">
                <span><i class="fa fa-filter me-2"></i> Select Program for Synchronization</span>
            </div>

            <div class="row align-items-end justify-content-center">
                <div class="col-md-7 mb-3">
                    <div class="wub-form-group mb-0">
                        <label for="program">Program</label>
                        <select class="select2" id="program" name="program" data-placeholder="Choose Program">
                            <option value=""></option>
                            {{#programs}}
                                <option value="{{id}}">{{title}}</option>
                            {{/programs}}
                        </select>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <button class="btn btn-wub-primary w-100 ladda-button" data-size="sm" type="button" id="search_programs" data-style="zoom-in"><label class="ladda-label"><i class="fa fa-search me-1"></i> Load Students</label></button>
                </div>
            </div>
        </div>

        <div class="wub-section-card" id="output" style="display: none;">
            <div class="wub-card-title mb-3">
                <span><i class="fa fa-users me-2"></i> Student Synchronization List</span>
            </div>

            <div class="wub-search-box-wrapper">
                <i class="fa fa-search search-icon"></i>
                <input type="text" id="sync_search_box" class="search" placeholder="Type to filter loaded students..." onkeyup="filterSyncTable()" />
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" style="background: #ffffff; border-radius: 10px; overflow: hidden;">
                    <thead style="background: #0A246A; color: #ffffff;">
                        <tr>
                            <th width="5%" class="text-center" style="color: #fff;">
                                <input type="checkbox" id="select_all_sync" onclick="sAll(this,'#sync_table input:checkbox');" checked style="accent-color: #ffffff; width: 16px; height: 16px; cursor: pointer;" />
                            </th>
                            <th width="40%" style="color: #fff;">Student Name</th>
                            <th width="40%" style="color: #fff;">Email Address</th>
                            <th width="15%" class="text-end" style="color: #fff;">Sync Status</th>
                        </tr>
                    </thead>
                    <tbody id="sync_table"></tbody>
                </table>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-wub-success ladda-button" id="sync_btn" data-style="zoom-out">
                    <span class="ladda-label"><i class="fa fa-refresh me-1"></i> Synchronize Selected Data</span>
                </button>
            </div>
        </div>
    </form>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    $(function(){
        $('.select2').select2({
            theme: 'classic',
            width: '100%',
        });

        $('#search_programs').click(function () {
            let l = Ladda.create(this);
            l.start();

            let program = $('#program').val();
            if (program){
                $.ajax({
                    url: '/local/mass_enroll/api.php',
                    method: 'POST',
                    data: {
                        sync_program: program,
                    },
                    success: function (res) {
                        try {
                            let obj = (typeof res === 'string') ? JSON.parse(res) : res;
                            let tr = '';
                            if (Array.isArray(obj)) {
                                for (let o of obj){
                                    tr += setTableBodyTr(o);
                                }
                            } else if (typeof obj === 'object') {
                                Object.entries(obj).forEach(([key, o]) => {
                                    tr += setTableBodyTr(o);
                                });
                            }
                            ls(l);
                            let table_body = $('#sync_table');
                            table_body.empty();
                            if (tr){
                                table_body.append(tr);
                            } else {
                                table_body.append('<tr><td colspan="4" class="text-center text-muted p-4">No students found for synchronization.</td></tr>');
                            }
                            $("#output").show();
                            $('#sync_btn').show();
                        } catch (e) {
                            ls(l, 1000);
                        }
                    },
                    error: function (err) {
                        ls(l, 1000);
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: "System Error!! Error Code: " + err.status,
                        });
                    }
                });
            } else {
                ls(l, 1500);
                Swal.fire({
                    icon: 'warning',
                    title: 'Oops...',
                    text: "Please select any program",
                });
            }
        });

        $("#bulk_sync").submit(function (e) {
            e.preventDefault();
            let l = Ladda.create(document.querySelector('#sync_btn'));
            l.start();

            $.ajax({
                url: '/local/mass_enroll/api.php',
                cache: false,
                contentType: false,
                processData: false,
                method: 'POST',
                data: new FormData(this),
                success: function (res) {
                    try{
                        let obj = (typeof res === 'string') ? JSON.parse(res) : res;
                        if (Array.isArray(obj)) {
                            for (let o of obj){
                                $('#id'+o.user_id).html('<span class="badge badge-success" style="background:#059669; color:#fff; padding:4px 8px; border-radius:12px;">SYNCED</span>');
                            }
                        }
                    }catch (e) {}
                    ls(l);
                    $('#sync_btn').hide();
                },
                error: function (err) {
                    ls(l, 2000);
                }
            });
        });
    });

    function sAll(elemEnt, eachAll='input:checkbox'){
        var status = $(elemEnt).is(":checked");
        $(eachAll).each(function(){
            const d = $(this).attr('disabled');
            if (d != 'disabled'){
                $(this).prop('checked', status);
            }
        });
    }

    function setTableBodyTr(obj){
        let status = ((obj.sync == null) ? 'NOT_SYNC' : 'SYNC');
        let name = (obj.firstname || '') + ' ' + (obj.lastname || '');
        if (!name.trim()) name = obj.username || 'Student';

        let tr = '';
        tr += '<tr>';
        tr += '<td class="text-center"><input type="checkbox" name="user['+obj.id+']" '+ ((status == 'SYNC') ? 'disabled' : 'checked') +' style="accent-color:#0A246A; width:16px; height:16px;" /></td>';
        tr += '<td><strong style="color:#0A246A;">'+ name +'</strong></td>';
        tr += '<td><span style="color:#475569;">'+ (obj.email || '') +'</span></td>';
        tr += '<td class="text-end" id="id'+obj.id+'">';
        if (status == 'SYNC') {
            tr += '<span class="badge badge-success" style="background:#059669; color:#fff; padding:4px 8px; border-radius:12px;">SYNCED</span>';
        } else {
            tr += '<span class="badge badge-secondary" style="background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; padding:4px 8px; border-radius:12px;">NOT SYNCED</span>';
        }
        tr += '</td>';
        tr += '</tr>';
        return tr;
    }

    function ls(l, m_sec=500){
        setTimeout(()=>{
            if (l) l.stop();
        }, m_sec);
    }

    function filterSyncTable() {
        var input = document.getElementById('sync_search_box');
        var filter = input.value.toLowerCase();
        var rows = document.querySelectorAll('#sync_table tr');
        rows.forEach(function(row) {
            var text = row.textContent || row.innerText;
            if (text.toLowerCase().indexOf(filter) > -1) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }
</script>