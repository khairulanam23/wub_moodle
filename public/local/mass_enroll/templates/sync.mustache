{{!
    @template local_mass_enroll/sync
}}

<div class="wub-mass-enroll-container">
    <div class="wub-banner-header">
        <div>
            <h2><i class="fa fa-refresh me-2"></i>WUB UMS Student Synchronization</h2>
            <p>Fetch and synchronize UMS student program and batch information with your local Moodle database.</p>
        </div>
        <div>
            <a href="/local/mass_enroll/enrolled.php" class="wub-banner-btn-solid"><i class="fa fa-graduation-cap me-1"></i> Bulk Enrolment</a>
        </div>
    </div>

    <form action="/local/mass_enroll/api.php" method="POST" id="bulk_sync">
        <input type="hidden" name="sesskey" value="{{sesskey}}" />
        <input type="hidden" name="action" value="create_selected_users" />
        
        <div class="wub-section-card mb-4">
            <div class="wub-card-title">
                <span><i class="fa fa-filter me-2"></i> Select Program & Batch for Synchronization</span>
            </div>

            <div class="row align-items-end justify-content-center">
                <div class="col-md-5 mb-3">
                    <div class="wub-form-group mb-0">
                        <label for="program">Program</label>
                        <select class="select2" id="program" name="program" data-placeholder="Choose Program">
                            <option value=""></option>
                            {{#programs}}
                                <option value="{{id}}">{{title}}</option>
                            {{/programs}}
                        </select>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <div class="wub-form-group mb-0">
                        <label for="batch">Batch (Optional)</label>
                        <select class="select2" id="batch" name="batch" data-placeholder="All Batches">
                            <option value="">All Batches</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <button class="btn btn-wub-primary w-100 ladda-button" data-size="sm" type="button" id="search_programs" data-style="zoom-in">
                        <label class="ladda-label"><i class="fa fa-search me-1"></i> Load Students</label>
                    </button>
                </div>
            </div>
        </div>

        <div class="wub-section-card" id="output" style="display: none;">
            <div class="wub-card-title mb-3 d-flex justify-content-between align-items-center">
                <span><i class="fa fa-users me-2"></i> Student Synchronization List</span>
                <span id="sync_summary_badge" class="badge bg-secondary p-2"></span>
            </div>

            <div class="wub-search-box-wrapper mb-3">
                <i class="fa fa-search search-icon"></i>
                <input type="text" id="sync_search_box" class="search" placeholder="Type to filter loaded students by name, email or status..." />
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" style="background: #ffffff; border-radius: 10px; overflow: hidden;">
                    <thead style="background: var(--wub-primary, #0f6cbf); color: #ffffff;">
                        <tr>
                            <th width="5%" class="text-center" style="color: #fff;">
                                <input type="checkbox" id="select_all_sync" checked style="accent-color: #ffffff; width: 16px; height: 16px; cursor: pointer;" />
                            </th>
                            <th width="30%" style="color: #fff;">Student Name & ID</th>
                            <th width="30%" style="color: #fff;">Email Address</th>
                            <th width="15%" class="text-center" style="color: #fff;">UMS Status</th>
                            <th width="20%" class="text-end" style="color: #fff;">Status</th>
                        </tr>
                    </thead>
                    <tbody id="sync_table"></tbody>
                </table>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-wub-success ladda-button" id="sync_btn" data-style="zoom-out">
                    <span class="ladda-label"><i class="fa fa-refresh me-1"></i> Sync Selected Students to Local Database</span>
                </button>
            </div>
        </div>
    </form>
</div>