{{!
    @template local_header/header

    Transparent WUB Header Mustache Template with Logo on the Left.
}}

<header class="wub-custom-header wub-header-transparent" id="wub-custom-header">
    <div class="wub-header-container wub-navbar-inner">
        <a href="{{ logolinkurl }}" class="wub-header-brand-logo" id="wub-logo-link" title="World University of Bangladesh">
            <img src="{{ logourl }}" alt="World University of Bangladesh" class="wub-navbar-logo">
        </a>
    </div>
</header>
