{{!
    @template local_bulk_enrolment/ums_diagnostics

    Diagnostic Console and UMS API Management portal for WUB UMS Integration.
}}
<div class="local-bulk-enrolment-ums-console container-fluid p-0">

    {{#notice}}
    <div class="alert alert-{{notice_type}} alert-dismissible fade show mb-4" role="alert">
        <i class="fa fa-info-circle mr-2"></i>{{notice_message}}
    </div>
    {{/notice}}

    <!-- Top Summary Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="card-title text-primary mb-1">
                            <i class="fa fa-network-wired mr-2"></i>{{#str}}diag_heading, local_bulk_enrolment{{/str}}
                        </h4>
                        <p class="card-text text-muted small mb-0">
                            Authoritative external integration boundary between World University of Bangladesh UMS and Moodle.
                        </p>
                    </div>
                    <div>
                        <a href="{{settings_url}}" class="btn btn-outline-primary btn-sm">
                            <i class="fa fa-cog mr-1"></i>Configure Credentials
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Diagnostic Cards Grid -->
    <div class="row">
        <!-- Configuration Status -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-left-primary">
                <div class="card-header bg-white font-weight-bold py-3 d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-sliders-h mr-2 text-primary"></i>{{#str}}diag_status_card, local_bulk_enrolment{{/str}}</span>
                    <form method="post" action="{{action_url}}" class="d-inline m-0">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="tab" value="ums">
                        <input type="hidden" name="action" value="purge_cache">
                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="Clear MUC cached programs and batches">
                            <i class="fa fa-broom mr-1"></i>{{#str}}diag_btn_purge, local_bulk_enrolment{{/str}}
                        </button>
                    </form>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted w-40">Integration State:</th>
                                <td>
                                    {{#is_enabled}}
                                    <span class="badge badge-success px-2 py-1"><i class="fa fa-check mr-1"></i>{{#str}}status_enabled, local_bulk_enrolment{{/str}}</span>
                                    {{/is_enabled}}
                                    {{^is_enabled}}
                                    <span class="badge badge-secondary px-2 py-1"><i class="fa fa-ban mr-1"></i>{{#str}}status_disabled, local_bulk_enrolment{{/str}}</span>
                                    {{/is_enabled}}
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted">Configuration:</th>
                                <td>
                                    {{#is_configured}}
                                    <span class="badge badge-info px-2 py-1"><i class="fa fa-lock mr-1"></i>{{#str}}status_configured, local_bulk_enrolment{{/str}}</span>
                                    {{/is_configured}}
                                    {{^is_configured}}
                                    <span class="badge badge-warning px-2 py-1 text-dark"><i class="fa fa-exclamation-triangle mr-1"></i>{{#str}}status_not_configured, local_bulk_enrolment{{/str}}</span>
                                    {{/is_configured}}
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted">API Base URL:</th>
                                <td><code>{{base_url}}</code></td>
                            </tr>
                            <tr>
                                <th class="text-muted">Authentication:</th>
                                <td>
                                    <span class="small font-weight-bold text-dark">HTTP Digest + Dynamic X-API-KEY</span>
                                    <div class="text-muted small">Query string on GET; Request body on POST</div>
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted">SSL Verification:</th>
                                <td>
                                    {{#ssl_verify}}
                                    <span class="badge badge-success px-2 py-1">{{#str}}status_ssl_active, local_bulk_enrolment{{/str}}</span>
                                    {{/ssl_verify}}
                                    {{^ssl_verify}}
                                    <span class="badge badge-danger px-2 py-1">{{#str}}status_ssl_disabled, local_bulk_enrolment{{/str}}</span>
                                    {{/ssl_verify}}
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted">Timeouts:</th>
                                <td class="small text-muted">
                                    Connect: <strong>{{connect_timeout}}s</strong> | Request: <strong>{{timeout}}s</strong>
                                </td>
                            </tr>
                            <tr>
                                <th class="text-muted">Security:</th>
                                <td class="small text-muted">
                                    <i class="fa fa-shield-alt text-success mr-1"></i>Credentials masked; zero secrets logged or exposed.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Connection Test Card -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-left-info">
                <div class="card-header bg-white font-weight-bold py-3 d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-heartbeat mr-2 text-info"></i>{{#str}}diag_test_card, local_bulk_enrolment{{/str}}</span>
                    <form method="post" action="{{action_url}}" class="m-0">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="tab" value="ums">
                        <input type="hidden" name="action" value="test_connection">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa fa-play mr-1"></i>{{#str}}diag_btn_test, local_bulk_enrolment{{/str}}
                        </button>
                    </form>
                </div>
                <div class="card-body">
                    {{#has_test_result}}
                        {{#test_result.success}}
                        <div class="alert alert-success border-0 mb-3 py-2">
                            <h6 class="alert-heading font-weight-bold mb-1">
                                <i class="fa fa-check-circle mr-1"></i>{{#str}}test_result_success, local_bulk_enrolment{{/str}}
                            </h6>
                            <span class="small">HTTP GET <code>{{test_result.endpoint}}</code> responded normally.</span>
                        </div>
                        <table class="table table-sm table-bordered bg-light mb-0">
                            <tbody>
                                <tr>
                                    <th class="w-50 text-muted">{{#str}}test_http_status, local_bulk_enrolment{{/str}}</th>
                                    <td><span class="badge badge-success">{{test_result.http_code}} OK</span></td>
                                </tr>
                                <tr>
                                    <th class="text-muted">{{#str}}test_latency, local_bulk_enrolment{{/str}}</th>
                                    <td><strong>{{test_result.latency_ms}} ms</strong></td>
                                </tr>
                                <tr>
                                    <th class="text-muted">{{#str}}test_programs_count, local_bulk_enrolment{{/str}}</th>
                                    <td><span class="badge badge-pill badge-primary">{{test_result.programs_count}}</span></td>
                                </tr>
                            </tbody>
                        </table>
                        {{/test_result.success}}

                        {{^test_result.success}}
                        <div class="alert alert-danger border-0 mb-3 py-2">
                            <h6 class="alert-heading font-weight-bold mb-1">
                                <i class="fa fa-times-circle mr-1"></i>{{#str}}test_result_failure, local_bulk_enrolment{{/str}}
                            </h6>
                            <span class="small">{{test_result.error}}</span>
                        </div>
                        <table class="table table-sm table-bordered bg-light mb-0">
                            <tbody>
                                <tr>
                                    <th class="w-50 text-muted">{{#str}}test_endpoint_tested, local_bulk_enrolment{{/str}}</th>
                                    <td><code>{{test_result.endpoint}}</code></td>
                                </tr>
                                <tr>
                                    <th class="text-muted">{{#str}}test_http_status, local_bulk_enrolment{{/str}}</th>
                                    <td>
                                        {{#test_result.http_code}}
                                        <span class="badge badge-danger">HTTP {{test_result.http_code}}</span>
                                        {{/test_result.http_code}}
                                        {{^test_result.http_code}}
                                        <span class="badge badge-secondary">No Response / Network Error</span>
                                        {{/test_result.http_code}}
                                    </td>
                                </tr>
                                <tr>
                                    <th class="text-muted">{{#str}}test_latency, local_bulk_enrolment{{/str}}</th>
                                    <td>{{test_result.latency_ms}} ms</td>
                                </tr>
                            </tbody>
                        </table>
                        {{/test_result.success}}
                    {{/has_test_result}}

                    {{^has_test_result}}
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-stethoscope fa-3x mb-3 text-secondary"></i>
                        <p class="mb-2">Click <strong>"{{#str}}diag_btn_test, local_bulk_enrolment{{/str}}"</strong> to execute an authentic network verification against the UMS programs endpoint.</p>
                        <span class="small text-muted">Sensitive credentials, passwords, and API keys are never transmitted to browser client-side.</span>
                    </div>
                    {{/has_test_result}}
                </div>
            </div>
        </div>
    </div>

    <!-- Supported UMS API Contract Card -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white font-weight-bold py-3">
                    <i class="fa fa-book-open mr-2 text-primary"></i>{{#str}}diag_endpoints_card, local_bulk_enrolment{{/str}}
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 25%;">Endpoint API</th>
                                    <th style="width: 10%;">Method</th>
                                    <th style="width: 35%;">URI Path</th>
                                    <th style="width: 15%;">Key Placement</th>
                                    <th style="width: 15%;">Caching</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="font-weight-bold small">API #1: Student Details by Usernames</td>
                                    <td><span class="badge badge-primary">POST</span></td>
                                    <td><code>/students/multiple_username_wise_std_details</code></td>
                                    <td><span class="badge badge-light border">Request Body</span></td>
                                    <td><span class="badge badge-secondary">No Cache</span></td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold small">API #2: Academic Programs Catalog</td>
                                    <td><span class="badge badge-success">GET</span></td>
                                    <td><code>/students/programs</code></td>
                                    <td><span class="badge badge-light border">Query String</span></td>
                                    <td><span class="badge badge-info">MUC (30 min)</span></td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold small">API #3: Batches by Program</td>
                                    <td><span class="badge badge-success">GET</span></td>
                                    <td><code>/students/batches/{program_id}</code></td>
                                    <td><span class="badge badge-light border">Query String</span></td>
                                    <td><span class="badge badge-info">MUC (15 min)</span></td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold small">API #4: Student Enrolment List</td>
                                    <td><span class="badge badge-success">GET</span></td>
                                    <td><code>/students/enroll_student_list_program_batch_wise/{p_id}/{b_id}</code></td>
                                    <td><span class="badge badge-light border">Query String</span></td>
                                    <td><span class="badge badge-secondary">Real-time</span></td>
                                </tr>
                                <tr>
                                    <td class="font-weight-bold small">API #5: User Sync by Registration IDs</td>
                                    <td><span class="badge badge-primary">POST</span></td>
                                    <td><code>/students/reg_id_wise_multi_student_info</code></td>
                                    <td><span class="badge badge-light border">Request Body</span></td>
                                    <td><span class="badge badge-secondary">No Cache</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
