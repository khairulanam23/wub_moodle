{{!
    @template local_bulk_enrolment/ws_program_list

    Program checkboxes for the workspace.

    Context variables required for this template:
    * programs (array of {id, title, short_title, is_active, selected})
}}
{{#programs}}
<label class="be-item d-flex align-items-center gap-2 px-2 py-2 mb-0 border-bottom" data-search="{{title}} {{short_title}} {{id}}">
    <input type="checkbox" class="form-check-input be-program-checkbox mt-0" value="{{id}}" data-title="{{title}}" data-short="{{short_title}}" {{#selected}}checked{{/selected}}>
    <span class="flex-grow-1 be-item-title"><span class="font-weight-medium text-dark">{{title}}</span>{{#short_title}} <span class="be-code-pill small ms-1">{{short_title}}</span>{{/short_title}}</span>
    <span class="badge badge-light border small text-muted font-monospace" title="UMS program id">#{{id}}</span>
    {{^is_active}}<span class="badge badge-secondary small">inactive</span>{{/is_active}}
</label>
{{/programs}}
{{^programs}}
<div class="be-empty-state text-center text-muted py-4 small">
    <i class="fa fa-folder-open mb-2 d-block fa-2x opacity-50" aria-hidden="true"></i>
    No programs returned by UMS.
</div>
{{/programs}}
