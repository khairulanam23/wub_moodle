{{!
    @template local_bulk_enrolment/ws_matrix

    Verification matrix.

    Context variables required for this template:
    * summary {total, ready, already_enrolled, issues}
    * rows (matrix rows from the preview_matrix external function)
}}
<div class="row g-2 mb-3 be-stats-grid">
    <div class="col-6 col-md-3">
        <div class="be-stat-card p-2 border rounded bg-light text-center">
            <div class="h4 mb-0 font-weight-bold text-dark">{{summary.total}}</div>
            <span class="d-block text-muted small mt-1 font-weight-medium"><i class="fa fa-th-list me-1 text-primary"></i>Combinations</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="be-stat-card be-stat-ready p-2 border rounded bg-light text-center">
            <div class="h4 mb-0 font-weight-bold text-success">{{summary.ready}}</div>
            <span class="d-block text-muted small mt-1 font-weight-medium"><i class="fa fa-check-circle me-1 text-success"></i>{{#str}}status_ready, local_bulk_enrolment{{/str}}</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="be-stat-card be-stat-enrolled p-2 border rounded bg-light text-center">
            <div class="h4 mb-0 font-weight-bold text-info">{{summary.already_enrolled}}</div>
            <span class="d-block text-muted small mt-1 font-weight-medium"><i class="fa fa-user-check me-1 text-info"></i>{{#str}}status_already_enrolled, local_bulk_enrolment{{/str}}</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="be-stat-card be-stat-issues p-2 border rounded bg-light text-center">
            <div class="h4 mb-0 font-weight-bold {{#summary.issues}}text-danger{{/summary.issues}}{{^summary.issues}}text-secondary{{/summary.issues}}">{{summary.issues}}</div>
            <span class="d-block text-muted small mt-1 font-weight-medium"><i class="fa fa-ban me-1 {{#summary.issues}}text-danger{{/summary.issues}}"></i>Blocked</span>
        </div>
    </div>
</div>
<div class="table-responsive be-matrix-scroll border rounded">
<table class="table table-sm table-bordered table-hover mb-0 align-middle">
    <thead class="thead-light">
        <tr>
            <th scope="col" class="be-col-student">Student</th>
            <th scope="col" class="be-col-course">Course</th>
            <th scope="col" class="be-col-status">Status</th>
            <th scope="col" class="be-col-message">Explanation</th>
        </tr>
    </thead>
    <tbody>
    {{#rows}}
        <tr class="be-matrix-row" data-status="{{status}}">
            <td class="small align-middle"><div class="font-weight-bold text-dark">{{fullname}}</div><span class="text-muted be-code-pill font-monospace">{{username}}</span>{{#reg_id}} <span class="text-muted small">· {{reg_id}}</span>{{/reg_id}}</td>
            <td class="small align-middle"><span class="font-weight-medium text-dark">{{coursename}}</span> <span class="text-muted small">({{courseshortname}})</span></td>
            <td class="small align-middle"><span class="badge {{badge_class}}">{{status_label}}</span></td>
            <td class="small align-middle text-muted">{{message}}</td>
        </tr>
    {{/rows}}
    </tbody>
</table>
</div>
