{{!
    @template local_bulk_enrolment/sync_page

    Authoritative WUB UMS Student Synchronization Workspace.
}}
<div class="local-bulk-enrolment-sync container-fluid p-0" id="wub-sync-workspace" data-sesskey="{{sesskey}}">
    {{#notice}}<div class="alert alert-{{notice_type}} py-2" role="alert">{{notice_message}}</div>{{/notice}}

    <!-- Top Banner Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body py-3 d-flex justify-content-between align-items-center flex-wrap">
                    <div>
                        <h4 class="card-title text-primary mb-1">
                            <i class="fa fa-sync-alt mr-2"></i>{{#str}}sync_heading, local_bulk_enrolment{{/str}}
                        </h4>
                        <p class="card-text text-muted small mb-0">
                            Synchronize student information, program, batch, and registration IDs from authoritative WUB UMS to local Moodle.
                        </p>
                    </div>
                    <div class="mt-2 mt-md-0">
                        <span class="badge badge-success px-3 py-2 text-white font-weight-bold">
                            <i class="fa fa-user-plus mr-1"></i>Authoritative Account Provisioning: Active
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Step 1: Program & Batch Comparison Filter Form -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white font-weight-bold py-2">
                    <i class="fa fa-filter mr-2"></i>1. Select Academic Program & Batch for UMS Synchronization
                </div>
                <div class="card-body py-3">
                    <form action="{{action_url}}" method="POST" id="form-compare-sync">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="tab" value="sync">
                        <input type="hidden" name="action" value="compare_sync">

                        <div class="form-row align-items-end">
                            <div class="col-md-5 mb-3 mb-md-0">
                                <label for="sync-program-select" class="small font-weight-bold text-muted mb-1">Academic Program (UMS API #2)</label>
                                <select class="custom-select custom-select-sm" id="sync-program-select" name="program_id" required>
                                    <option value="">-- Choose Program --</option>
                                    {{#programs}}
                                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                                    {{/programs}}
                                </select>
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label for="sync-batch-select" class="small font-weight-bold text-muted mb-1">Academic Batch (Optional / All Batches)</label>
                                <select class="custom-select custom-select-sm" id="sync-batch-select" name="batch_id">
                                    <option value="0">-- All Batches (0) --</option>
                                    {{#batches}}
                                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                                    {{/batches}}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary btn-sm btn-block font-weight-bold" id="btn-load-sync-students">
                                    <i class="fa fa-search mr-1"></i>Load & Compare Students
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {{#has_sync_report}}
    <!-- Sync Execution Results Banner -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white font-weight-bold py-2 d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-check-circle mr-2"></i>Synchronization Execution Report</span>
                    <span class="badge badge-light font-weight-bold">{{sync_report.created}} created, {{sync_report.updated}} updated</span>
                </div>
                <div class="card-body py-3">
                    <div class="row text-center mb-3">
                        <div class="col-6 col-md-3 mb-2 mb-md-0">
                            <div class="p-2 border rounded bg-light">
                                <div class="h5 text-primary font-weight-bold mb-0">{{sync_report.created}}</div>
                                <div class="small text-muted">Accounts Created</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3 mb-2 mb-md-0">
                            <div class="p-2 border rounded bg-light">
                                <div class="h5 text-success font-weight-bold mb-0">{{sync_report.updated}}</div>
                                <div class="small text-muted">Accounts Updated</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded bg-light">
                                <div class="h5 text-secondary font-weight-bold mb-0">{{sync_report.skipped}}</div>
                                <div class="small text-muted">Already Synced</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded bg-light">
                                <div class="h5 text-danger font-weight-bold mb-0">{{sync_report.failed}}</div>
                                <div class="small text-muted">Failed / Blocked</div>
                            </div>
                        </div>
                    </div>

                    {{#sync_report.has_log}}
                    <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-striped small mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Username</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#sync_report.log}}
                                <tr>
                                    <td><strong>{{username}}</strong></td>
                                    <td><span class="badge {{badge_class}}{{^badge_class}}badge-info{{/badge_class}}">{{status}}</span></td>
                                    <td>{{reason}}</td>
                                </tr>
                                {{/sync_report.log}}
                            </tbody>
                        </table>
                    </div>
                    {{/sync_report.has_log}}
                </div>
            </div>
        </div>
    </div>
    {{/has_sync_report}}

    {{#has_comparison}}
    <!-- Step 2: Student Synchronization Comparison Matrix -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info text-white font-weight-bold py-2 d-flex justify-content-between align-items-center">
                    <span><i class="fa fa-users mr-2"></i>2. Student Synchronization Comparison Matrix</span>
                    <span class="badge badge-light font-weight-bold">{{comparison.summary.total_ums}} UMS Records</span>
                </div>
                <div class="card-body py-3">

                    <!-- KPI Statistics Cards -->
                    <div class="row text-center mb-3">
                        <div class="col-6 col-md-3 mb-2">
                            <div class="p-2 border rounded bg-light">
                                <div class="h5 text-primary font-weight-bold mb-0">{{comparison.summary.total_ums}}</div>
                                <div class="small text-muted">Total in UMS</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <div class="p-2 border rounded bg-light">
                                <div class="h5 text-success font-weight-bold mb-0">{{comparison.summary.synced_count}}</div>
                                <div class="small text-muted">Synced in Moodle</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <div class="p-2 border rounded bg-light">
                                <div class="h5 text-warning font-weight-bold mb-0">{{comparison.summary.updatable_count}}</div>
                                <div class="small text-muted">Ready for Safe Update</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3 mb-2">
                            <div class="p-2 border rounded bg-light">
                                <div class="h5 text-info font-weight-bold mb-0">{{comparison.summary.unmatched_count}}</div>
                                <div class="small text-muted">Ready to Create</div>
                            </div>
                        </div>
                    </div>

                    <!-- Filter & Search Bar -->
                    <div class="input-group input-group-sm mb-3">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fa fa-search"></i></span>
                        </div>
                        <input type="text" class="form-control" id="sync-table-search" placeholder="Type to filter loaded students by name, email, registration ID or status...">
                        <div class="input-group-append">
                            <span class="input-group-text bg-white" id="sync-selected-badge">0 selected</span>
                        </div>
                    </div>

                    <!-- Sync Form -->
                    <form action="{{action_url}}" method="POST" id="form-execute-sync">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="tab" value="sync">
                        <input type="hidden" name="action" value="execute_sync">
                        <input type="hidden" name="program_id" value="{{selected_program_id}}">
                        <input type="hidden" name="batch_id" value="{{selected_batch_id}}">

                        <div class="table-responsive border rounded mb-3" style="max-height: 420px; overflow-y: auto;">
                            <table class="table table-sm table-hover table-striped mb-0 small" id="sync-table">
                                <thead class="thead-light">
                                    <tr>
                                        <th width="4%" class="text-center">
                                            <input type="checkbox" id="chk-select-all-sync" style="cursor: pointer;">
                                        </th>
                                        <th width="26%">Student Name & ID</th>
                                        <th width="20%">Institutional Email</th>
                                        <th width="15%">UMS Program & Batch</th>
                                        <th width="20%">Previous / Active Courses</th>
                                        <th width="15%" class="text-right">Local DB Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#comparison.students}}
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox" name="selected_usernames[]" value="{{username}}" class="sync-student-checkbox" {{#can_update}}checked{{/can_update}} {{#is_ambiguous}}disabled{{/is_ambiguous}} aria-label="Select {{full_name}}">
                                        </td>
                                        <td>
                                            <strong class="text-primary">{{full_name}}</strong>
                                            <div class="text-muted">
                                                <i class="fa fa-id-card mr-1"></i>{{reg_id}} (Username: <code>{{username}}</code>)
                                            </div>
                                        </td>
                                        <td>
                                            <i class="fa fa-envelope mr-1 text-muted"></i>{{email}}
                                        </td>
                                        <td>
                                            <div><strong>{{program_name}}</strong></div>
                                            {{#batch_name}}<span class="badge badge-light border text-muted">Batch: {{batch_name}}</span>{{/batch_name}}
                                        </td>
                                        <td>
                                            {{#course_codes}}
                                            <span class="badge badge-light border text-dark font-weight-normal">{{course_codes}}</span>
                                            {{/course_codes}}
                                            {{^course_codes}}
                                            <span class="text-muted">None registered</span>
                                            {{/course_codes}}
                                        </td>
                                        <td class="text-right">
                                            <span class="badge {{badge_class}} px-2 py-1">{{status_label}}</span>
                                            {{#update_fields}}
                                            <div class="small text-muted mt-1">Updates: {{update_fields}}</div>
                                            {{/update_fields}}
                                        </td>
                                    </tr>
                                    {{/comparison.students}}
                                    {{^comparison.students}}
                                    <tr>
                                        <td colspan="6" class="text-center text-muted p-4">
                                            <i class="fa fa-info-circle fa-2x mb-2 text-info"></i>
                                            <p class="mb-0">No student records found in UMS for this selection.</p>
                                        </td>
                                    </tr>
                                    {{/comparison.students}}
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small text-muted">
                                <i class="fa fa-shield-alt mr-1 text-info"></i>Authoritative sync: Creates new Moodle accounts with initial credentials and updates metadata for existing accounts.
                            </span>
                            <button type="submit" class="btn btn-success font-weight-bold" id="btn-submit-sync">
                                <i class="fa fa-sync-alt mr-1"></i>Apply Safe Metadata Sync to Selected Students
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
    {{/has_comparison}}

    <!-- Step 3: Identity Inspector Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-secondary">
                <div class="card-header bg-white font-weight-bold py-2 text-secondary">
                    <i class="fa fa-search mr-2 text-secondary"></i>Direct Student Identity Inspector
                </div>
                <div class="card-body py-3">
                    <form action="{{action_url}}" method="POST" class="form-inline">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="tab" value="sync">
                        <input type="hidden" name="action" value="inspect_identity">

                        <div class="input-group input-group-sm w-100">
                            <input type="text" class="form-control" name="inspect_query" value="{{inspect_query}}" placeholder="Enter Registration ID, Username, or Student Email to test unambiguous identity resolution..." required>
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-outline-secondary">
                                    <i class="fa fa-search mr-1"></i>Resolve Identity
                                </button>
                            </div>
                        </div>
                    </form>

                    {{#has_inspect_result}}
                    <div class="mt-3">
                        {{#inspect_found}}
                        <div class="alert alert-success small mb-0">
                            <i class="fa fa-check-circle mr-2"></i><strong>Resolved Moodle Account:</strong>
                            User ID: <code>{{inspect_user.id}}</code> | Username: <code>{{inspect_user.username}}</code> | Name: <code>{{inspect_user.firstname}} {{inspect_user.lastname}}</code> | Email: <code>{{inspect_user.email}}</code> | Matched via: <code>{{inspect_matched_field}}</code>
                        </div>
                        {{/inspect_found}}
                        {{^inspect_found}}
                        <div class="alert alert-warning small mb-0">
                            <i class="fa fa-exclamation-circle mr-2"></i>Identity lookup status: <strong>{{inspect_status}}</strong>. No unique active Moodle user account resolved for '{{inspect_query}}'.
                        </div>
                        {{/inspect_found}}
                    </div>
                    {{/has_inspect_result}}
                </div>
            </div>
        </div>
    </div>

    <!-- Architectural Overview & Policies -->
    <div class="row">
        <!-- Subsystem Status -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-left-warning">
                <div class="card-header bg-white font-weight-bold py-3 text-dark">
                    <i class="fa fa-info-circle mr-2 text-warning"></i>Subsystem Operational Policy
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-3 small">
                        <i class="fa fa-shield-alt mr-2"></i>{{#str}}sync_deferred_notice, local_bulk_enrolment{{/str}}
                    </div>
                    <h6 class="font-weight-bold text-secondary mb-2 small">Architectural Principles:</h6>
                    <ul class="text-muted small pl-3 mb-0">
                        <li class="mb-2"><strong>Zero Synthetic IDs:</strong> Fake user IDs like <code>ums_1234</code> are strictly prohibited. Enrolment only operates on real Moodle accounts.</li>
                        <li class="mb-2"><strong>No Custom Redundant Tables:</strong> The legacy unindexed table <code>mdl_enrol_ums_user</code> is discarded. All metadata maps to standard Moodle profile fields.</li>
                        <li class="mb-2"><strong>Supported User APIs:</strong> All synchronization calls strictly delegate to core <code>user_update_user()</code>.</li>
                        <li class="mb-2"><strong>Unambiguous Resolution:</strong> The system matches students across numeric IDs, usernames, emails, and registration numbers without ambiguous guessing.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Canonical Mappings -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-left-primary">
                <div class="card-header bg-white font-weight-bold py-3 text-dark">
                    <i class="fa fa-table mr-2 text-primary"></i>Canonical UMS &rarr; Moodle Profile Mappings
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm table-striped mb-0 small">
                        <thead class="thead-light">
                            <tr>
                                <th>UMS Academic Field</th>
                                <th>Moodle User Field</th>
                                <th>Specification</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Program Name / Title</td>
                                <td><code>mdl_user.department</code></td>
                                <td>Official degree program (e.g. B.Sc in CSE)</td>
                            </tr>
                            <tr>
                                <td>Batch Name / Title</td>
                                <td><code>mdl_user.institution</code></td>
                                <td>Authoritative academic batch (e.g. 75A)</td>
                            </tr>
                            <tr>
                                <td>Official Registration ID</td>
                                <td><code>mdl_user.idnumber</code></td>
                                <td>University student registration number</td>
                            </tr>
                            <tr>
                                <td>Short Numeric ID</td>
                                <td><code>mdl_user.username</code></td>
                                <td>Institutional login identifier</td>
                            </tr>
                            <tr>
                                <td>Institutional Email</td>
                                <td><code>mdl_user.email</code></td>
                                <td><code>{username}@student.wub.edu.bd</code></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
