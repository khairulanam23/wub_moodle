{{!
    @template local_bulk_enrolment/result_report

    Final execution audit report.
}}
<div class="result-report-wrapper">
    <div class="alert alert-success d-flex align-items-center mb-3">
        <i class="fa fa-check-circle fa-2x mr-3"></i>
        <div>
            <h5 class="alert-heading mb-0 font-weight-bold">{{#str}}execution_complete, local_bulk_enrolment{{/str}}</h5>
            <span class="small">Batch operations have been processed through Moodle's native enrolment engine.</span>
        </div>
    </div>

    <!-- Final Summary KPI Bar -->
    <div class="row mb-3">
        <div class="col-md">
            <div class="p-2 border rounded bg-light text-center">
                <span class="d-block text-muted small">Total Processed</span>
                <span class="h5 font-weight-bold mb-0 text-dark">{{summary.total}}</span>
            </div>
        </div>
        <div class="col-md">
            <div class="p-2 border rounded bg-light text-center">
                <span class="d-block text-muted small">Successfully Enrolled</span>
                <span class="h5 font-weight-bold mb-0 text-success">{{summary.enrolled}}</span>
            </div>
        </div>
        <div class="col-md">
            <div class="p-2 border rounded bg-light text-center">
                <span class="d-block text-muted small">Already Enrolled</span>
                <span class="h5 font-weight-bold mb-0 text-info">{{summary.already_enrolled}}</span>
            </div>
        </div>
        <div class="col-md">
            <div class="p-2 border rounded bg-light text-center">
                <span class="d-block text-muted small">Reactivated</span>
                <span class="h5 font-weight-bold mb-0 text-warning">{{summary.reactivated}}</span>
            </div>
        </div>
        <div class="col-md">
            <div class="p-2 border rounded bg-light text-center">
                <span class="d-block text-muted small">Failed / Rolled Back</span>
                <span class="h5 font-weight-bold mb-0 {{#summary.failed}}text-danger{{/summary.failed}}{{^summary.failed}}text-muted{{/summary.failed}}">{{summary.failed}}</span>
            </div>
        </div>
    </div>

    <!-- Detailed Outcome Table -->
    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
        <table class="table table-sm table-striped table-bordered mb-0" id="results-table-export">
            <thead class="thead-light sticky-top">
                <tr>
                    <th scope="col">Course ID</th>
                    <th scope="col">User ID</th>
                    <th scope="col">Outcome Status</th>
                    <th scope="col">Result Message</th>
                </tr>
            </thead>
            <tbody>
                {{#records}}
                <tr>
                    <td class="small">{{courseid}}</td>
                    <td class="small font-weight-bold">{{userid}}</td>
                    <td>
                        <span class="badge {{badge_class}} px-2 py-1">{{status}}</span>
                    </td>
                    <td class="small">{{message}}</td>
                </tr>
                {{/records}}
            </tbody>
        </table>
    </div>
</div>
