{{!
    @template local_bulk_enrolment/ws_roster_table

    One page of the UMS roster.

    Context variables required for this template:
    * rows (array of roster rows from the get_roster external function, plus "selected")
}}
<div class="table-responsive be-roster-scroll border rounded">
<table class="table table-sm table-hover mb-0 be-roster-table align-middle">
    <thead class="thead-light">
        <tr>
            <th scope="col" class="be-col-check text-center"><span class="visually-hidden">Select</span></th>
            <th scope="col">Student</th>
            <th scope="col">Program / Batch</th>
            <th scope="col">{{#str}}ws_courses_history, local_bulk_enrolment{{/str}}</th>
            <th scope="col">Moodle Account</th>
        </tr>
    </thead>
    <tbody>
    {{#rows}}
        <tr class="be-roster-row {{^selectable}}be-row-unselectable{{/selectable}}" data-key="{{key}}">
            <td class="be-col-check text-center align-top pt-2">
                <input type="checkbox" class="form-check-input be-student-checkbox" value="{{key}}" data-regid="{{reg_id}}" data-name="{{full_name}}" data-batch="{{batch}}" {{#selected}}checked{{/selected}} aria-label="Select {{full_name}}">
            </td>
            <td class="align-top py-2">
                <div class="font-weight-bold text-dark be-student-name">{{full_name}}</div>
                <div class="small text-muted d-flex align-items-center gap-1 flex-wrap mt-1">
                    <span class="be-code-pill font-monospace">{{username}}</span>
                    {{#reg_id}}<span class="text-muted">·</span> <span class="font-monospace text-secondary">{{reg_id}}</span>{{/reg_id}}
                </div>
                {{#university_email}}<div class="small text-muted text-break mt-1">{{university_email}}</div>{{/university_email}}
            </td>
            <td class="align-top py-2 small">
                <div class="font-weight-medium text-dark">{{#program_short}}<span class="badge be-code-pill me-1">{{program_short}}</span>{{/program_short}}{{program_name}}</div>
                <div class="mt-1 d-flex align-items-center gap-1 flex-wrap">
                    <span class="badge badge-info">{{batch}}</span>
                    {{#shift}}<span class="text-muted">{{shift}}</span>{{/shift}}
                    {{#current_batch}}<span class="text-muted small">(mother {{mother_batch}})</span>{{/current_batch}}
                </div>
            </td>
            <td class="align-top py-2 small">
                {{#course_count}}
                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 be-courses-toggle d-inline-flex align-items-center gap-1" aria-expanded="false" aria-controls="be-courses-{{key}}">
                    <span>{{course_count}} course(s)</span>
                    <i class="fa fa-caret-down" aria-hidden="true"></i>
                </button>
                <ul class="list-unstyled mb-0 mt-2 be-course-list border-start ps-2 py-1 bg-light rounded" id="be-courses-{{key}}" hidden>
                    {{#courses}}<li class="py-1 border-bottom border-light"><span class="be-code-pill font-monospace">{{course_code}}</span> <span class="font-weight-medium">{{title}}</span>{{#credit}} <span class="text-muted">({{credit}} cr)</span>{{/credit}}{{#semester}} <span class="text-muted">· {{semester}}</span>{{/semester}}</li>{{/courses}}
                </ul>
                {{/course_count}}
                {{^course_count}}<span class="text-muted">—</span>{{/course_count}}
            </td>
            <td class="align-top py-2 small">
                {{#is_matched}}
                <span class="badge badge-success d-inline-flex align-items-center gap-1"><i class="fa fa-check-circle" aria-hidden="true"></i>{{#str}}ws_match_matched, local_bulk_enrolment{{/str}}</span>
                <div class="text-muted mt-1 font-monospace">{{moodle_username}}{{#moodle_email}} · {{moodle_email}}{{/moodle_email}}</div>
                {{#suspended}}<span class="badge badge-warning mt-1">suspended</span>{{/suspended}}
                {{/is_matched}}
                {{#is_not_found}}
                <span class="badge badge-secondary d-inline-flex align-items-center gap-1"><i class="fa fa-question-circle" aria-hidden="true"></i>{{#str}}ws_match_not_found, local_bulk_enrolment{{/str}}</span>
                <div class="text-muted mt-1 small">Provisioning deferred</div>
                {{/is_not_found}}
                {{#is_ambiguous}}
                <span class="badge badge-danger d-inline-flex align-items-center gap-1"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i>{{#str}}ws_match_ambiguous, local_bulk_enrolment{{/str}}</span>
                <div class="text-danger mt-1 small font-weight-bold">{{candidates}} accounts match</div>
                {{/is_ambiguous}}
            </td>
        </tr>
    {{/rows}}
    </tbody>
</table>
</div>
