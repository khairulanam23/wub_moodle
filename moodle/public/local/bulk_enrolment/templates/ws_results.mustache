{{!
    @template local_bulk_enrolment/ws_results

    Execution results.

    Context variables required for this template:
    * summary {chunks, enrolled, already_enrolled, reactivated, failed, grouped}
    * rows (array of {fullname, username, coursename, status, message, group, badge_class})
    * errors (array of strings)
}}
<div class="row g-2 mb-3 be-stats-grid">
    <div class="col-6 col-md-2"><div class="be-stat-card p-2 border rounded bg-light text-center"><div class="h4 mb-0 font-weight-bold text-success">{{summary.enrolled}}</div><span class="d-block text-muted small mt-1 font-weight-medium"><i class="fa fa-user-plus me-1 text-success"></i>Enrolled</span></div></div>
    <div class="col-6 col-md-2"><div class="be-stat-card p-2 border rounded bg-light text-center"><div class="h4 mb-0 font-weight-bold text-primary">{{summary.reactivated}}</div><span class="d-block text-muted small mt-1 font-weight-medium"><i class="fa fa-redo me-1 text-primary"></i>Reactivated</span></div></div>
    <div class="col-6 col-md-2"><div class="be-stat-card p-2 border rounded bg-light text-center"><div class="h4 mb-0 font-weight-bold text-info">{{summary.already_enrolled}}</div><span class="d-block text-muted small mt-1 font-weight-medium"><i class="fa fa-user-check me-1 text-info"></i>Already enrolled</span></div></div>
    <div class="col-6 col-md-2"><div class="be-stat-card p-2 border rounded bg-light text-center"><div class="h4 mb-0 font-weight-bold text-secondary">{{summary.grouped}}</div><span class="d-block text-muted small mt-1 font-weight-medium"><i class="fa fa-users me-1 text-secondary"></i>In groups</span></div></div>
    <div class="col-6 col-md-2"><div class="be-stat-card p-2 border rounded bg-light text-center"><div class="h4 mb-0 font-weight-bold {{#summary.failed}}text-danger{{/summary.failed}}{{^summary.failed}}text-secondary{{/summary.failed}}">{{summary.failed}}</div><span class="d-block text-muted small mt-1 font-weight-medium"><i class="fa fa-exclamation-triangle me-1 text-danger"></i>Failed</span></div></div>
    <div class="col-6 col-md-2"><div class="be-stat-card p-2 border rounded bg-light text-center"><div class="h4 mb-0 font-weight-bold text-dark">{{summary.chunks}}</div><span class="d-block text-muted small mt-1 font-weight-medium"><i class="fa fa-cubes me-1 text-muted"></i>Chunks</span></div></div>
</div>
{{#errors}}<div class="alert alert-danger py-2 small mb-2 d-flex align-items-center gap-2"><i class="fa fa-exclamation-circle" aria-hidden="true"></i><span>{{.}}</span></div>{{/errors}}
<div class="table-responsive be-matrix-scroll border rounded">
<table class="table table-sm table-striped table-bordered mb-0 align-middle">
    <thead class="thead-light">
        <tr>
            <th scope="col">Student</th>
            <th scope="col">Course</th>
            <th scope="col">Outcome</th>
            <th scope="col">Detail</th>
            <th scope="col">Group</th>
        </tr>
    </thead>
    <tbody>
    {{#rows}}
        <tr>
            <td class="small"><div class="font-weight-bold text-dark">{{fullname}}</div><span class="text-muted be-code-pill font-monospace">{{username}}</span></td>
            <td class="small font-weight-medium text-dark">{{coursename}}</td>
            <td class="small"><span class="badge {{badge_class}}">{{status}}</span></td>
            <td class="small text-muted">{{message}}</td>
            <td class="small"><span class="badge badge-light border">{{group}}</span></td>
        </tr>
    {{/rows}}
    </tbody>
</table>
</div>
